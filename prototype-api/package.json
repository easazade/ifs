{
  "name": "prototype-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "openapi:generate": "pnpm build && node dist/generate-openapi.js",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:openapi": "pnpm build && node --test test/openapi-build.test.mjs",
    "db:start": "node scripts/database.mjs start",
    "db:start:memory": "node scripts/database.mjs memory",
    "db:setup": "node scripts/database.mjs setup",
    "db:status": "node scripts/database.mjs status",
    "db:sql": "node scripts/database.mjs sql",
    "dto:generate": "node scripts/generate-dto.mjs",
    "dto:generate:all": "node scripts/generate-dtos.mjs",
    "resource:generate": "node scripts/generate-resource.mjs",
    "resource:generate:all": "node scripts/generate-resources.mjs",
    "generate:all": "node scripts/generate-resources.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "18.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "surrealdb": "^2.0.10"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
