generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "sqlite"
}

// Add IFS models through /backend-entity <name>, using the standards schemas.
// Infrastructure setup intentionally does not invent domain models.

// <generated:model Scope source="../ifs-standards/src/entities/scope/scope.schema.json">
model Scope {
  id                     String  @id
  ifsId                  String
  entityType             String
  basedOn                String?
  entityDocumentationUrl String
  name                   String
  description            String?
  locations              Json?
  groups                 Json?
  objects                Json?
  entities               Json?
  parentScopeId          String?
  childScopeIds          Json?
  boundaryRules          Json?
  createdAt              String
  updatedAt              String
  extensions             Json?
  // <generated:inverse Role_scope>
  relationFromRoleScope  Role[]  @relation("Role_scope")
  // </generated:inverse Role_scope>
}

// </generated:model Scope>

// <generated:model Action source="../ifs-standards/src/entities/action/action.schema.json">
model Action {
  id                     String  @id
  ifsId                  String
  entityType             String
  basedOn                String?
  entityDocumentationUrl String
  createdAt              String
  updatedAt              String
  name                   String
  uniqueName             String
  requiresPermission     Boolean
  description            String
  instructions           String?
  notes                  String?
  warnings               String?
  state                  String

  // <generated:inverse Permission_actions>
  relationFromPermissionActions Permission[] @relation("Permission_actions")
  // </generated:inverse Permission_actions>
}

// </generated:model Action>

// <generated:model Permission source="../ifs-standards/src/entities/permission/permission.schema.json">
model Permission {
  id                            String   @id
  ifsId                         String
  entityType                    String
  basedOn                       String?
  entityDocumentationUrl        String
  actionIds                     Json
  actions                       Action[] @relation("Permission_actions")
  memberId                      String?
  roleId                        String?
  scopeId                       String
  scope                         Json?
  state                         String
  createdAt                     String
  updatedAt                     String?
  expiresAt                     String
  extensions                    Json?
  // <generated:inverse Role_permissions>
  relationFromRolePermissions   Role[]   @relation("Role_permissions")
  // </generated:inverse Role_permissions>
  // <generated:inverse Member_permissions>
  relationFromMemberPermissions Member[] @relation("Member_permissions")
  // </generated:inverse Member_permissions>
}

// </generated:model Permission>

// <generated:model Role source="../ifs-standards/src/entities/role/role.schema.json">
model Role {
  id                      String       @id
  ifsId                   String
  entityType              String
  basedOn                 String?
  entityDocumentationUrl  String
  name                    String
  description             String?
  memberId                String
  scopeId                 String
  scope                   Scope        @relation("Role_scope", fields: [scopeId], references: [id])
  permissions             Permission[] @relation("Role_permissions")
  state                   String
  createdAt               String
  updatedAt               String
  expiresAt               String?
  extensions              Json?
  // <generated:inverse Member_roles>
  relationFromMemberRoles Member[]     @relation("Member_roles")
  // </generated:inverse Member_roles>
}

// </generated:model Role>

// <generated:model Member source="../ifs-standards/src/entities/member/member.schema.json">
model Member {
  id                     String       @id
  ifsId                  String
  entityType             String
  entityDocumentationUrl String
  name                   String
  roles                  Role[]       @relation("Member_roles")
  permissions            Permission[] @relation("Member_permissions")
  isOwner                Boolean
  createdAt              String
  updatedAt              String
  extensions             Json?
}

// </generated:model Member>
