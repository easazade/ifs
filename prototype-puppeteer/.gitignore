# Dependencies
/node_modules/

# TypeScript build output and incremental state
/dist/
*.tsbuildinfo

# Test and coverage output
/coverage/
/.nyc_output/

# Local caches and temporary files
/.cache/
/.temp/
/.tmp/

# Puppeteer runtime artifacts
/.puppeteer-profile/
/downloads/
/screenshots/

# Logs and diagnostic reports
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.*.json

# Local environment files (keep templates tracked)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Editor and OS metadata
/.idea/
/.vscode/*
!/.vscode/extensions.json
.DS_Store
*.sw?
