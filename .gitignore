# Shared rules apply at the root and in every workspace.
# Keep lockfiles, source/generated source, design assets, and shared config tracked.

# Installed dependencies and optional repository-local pnpm store are reproducible.
node_modules/
.pnpm-store/

# Turbo caches and task logs are generated locally, not project source.
.turbo/

# Vite/Nest build output is regenerated by builds.
dist/
dist-ssr/

# TypeScript incremental state is machine-local (covers every tsconfig name).
*.tsbuildinfo

# Vite caches/temporary configs and optional lint/format caches are disposable.
.vite/
.vite-temp/
.eslintcache
.prettiercache

# Coverage reports and raw coverage data are generated by test runs.
coverage/
.nyc_output/

# Runtime/tool logs can contain local paths or sensitive diagnostic data.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files may contain secrets; sanitized templates stay trackable.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Personal Claude permissions/settings; shared commands and prompts stay trackable.
**/.claude/settings.local.json

# macOS Finder metadata is unrelated to the project.
.DS_Store
