{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/member.schema.json",
  "title": "Member",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Member/[^/\\s]+$",
      "description": "Globally unique identifier for this member."
    },
    "entityType": {
      "type": "string",
      "const": "Member",
      "description": "Entity type discriminator. Always \"Member\" for Member entities."
    },
    "name": { "type": "string", "description": "Human-readable name of the member." },
    "roles": {
      "type": "array",
      "items": { "$ref": "https://ifs-standards.org/schemas/v1/entities/role.schema.json" },
      "readOnly": true
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "https://ifs-standards.org/schemas/v1/entities/permission.schema.json" }
    },
    "isOwner": { "type": "boolean", "description": "Whether this member is considered an owner of the system." },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this member record was last updated."
    }
  },
  "required": ["name", "roles", "permissions", "isOwner", "updatedAt"],
  "x-ifs-relationships": [
    { "relationshipTypeId": "RelationshipType/ifs.employed-by", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.employed-by", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.manages", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.member-of", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.oversees", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.owns", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "target" }
  ]
}
