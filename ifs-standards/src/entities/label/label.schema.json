{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/label.schema.json",
  "title": "Label",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Label/[^/\\s]+$",
      "description": "Globally unique identifier for this label."
    },
    "entityType": {
      "type": "string",
      "const": "Label",
      "description": "Entity type discriminator. Always \"Label\" for Label entities."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this label was last updated."
    }
  },
  "required": ["updatedAt"],
  "x-ifs-relationships": []
}
