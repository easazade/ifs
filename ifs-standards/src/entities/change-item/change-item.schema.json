{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/change-item.schema.json",
  "title": "ChangeItem",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique identifier for this change item."
    },
    "ifsId": {
      "type": "string",
      "description": "IFS system identifier for this ChangeItem."
    },
    "entityType": {
      "type": "string",
      "const": "ChangeItem",
      "description": "Entity type discriminator. Always \"ChangeItem\" for ChangeItem entities."
    },
    "basedOn": {
      "type": "string",
      "description": "Id of the object this object is derived from."
    },
    "entityDocumentationUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL for documentation about this entity."
    },
    "resourceType": {
      "type": "string",
      "description": "Resource category for this change item, such as rule, scope, protocol, record, or resource."
    },
    "operation": {
      "type": "string",
      "enum": [
        "update",
        "create",
        "delete",
        "replace"
      ],
      "description": "Type of operation this item proposes for the target object."
    },
    "targetRef": {
      "type": [
        "string",
        "null"
      ],
      "format": "ifs-ref",
      "default": "ifs://object/current-target",
      "description": "Stable IFS reference for the logical object being changed. Null for create operations where no active target exists yet."
    },
    "baseRef": {
      "type": [
        "string",
        "null"
      ],
      "format": "ifs-ref",
      "default": "ifs://object/current-target@v1",
      "description": "IFS reference to the active version observed when the change item was authored. Used for conflict detection. Null for create operations."
    },
    "proposedRef": {
      "type": [
        "string",
        "null"
      ],
      "format": "ifs-ref",
      "default": "ifs://change/change_1/proposed/current-target",
      "description": "IFS reference to the proposed object or version produced by this change item. Null for delete operations."
    },
    "description": {
      "type": "string",
      "description": "Optional human-readable note explaining this specific item."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this change item was created."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this change item was last updated."
    }
  },
  "required": [
    "id",
    "ifsId",
    "entityType",
    "entityDocumentationUrl",
    "resourceType",
    "operation",
    "targetRef",
    "baseRef",
    "proposedRef",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "targetRef": {
            "type": "null"
          },
          "baseRef": {
            "type": "null"
          },
          "proposedRef": {
            "type": "string",
            "format": "ifs-ref"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "targetRef": {
            "type": "string",
            "format": "ifs-ref"
          },
          "baseRef": {
            "type": "string",
            "format": "ifs-ref"
          },
          "proposedRef": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "update",
              "replace"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "targetRef": {
            "type": "string",
            "format": "ifs-ref"
          },
          "baseRef": {
            "type": "string",
            "format": "ifs-ref"
          },
          "proposedRef": {
            "type": "string",
            "format": "ifs-ref"
          }
        }
      }
    }
  ]
}
