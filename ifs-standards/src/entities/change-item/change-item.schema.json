{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/change-item.schema.json",
  "title": "ChangeItem",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^ChangeItem/[^/\\s]+$",
      "description": "Globally unique identifier for this change item."
    },
    "entityType": {
      "type": "string",
      "const": "ChangeItem",
      "description": "Entity type discriminator. Always \"ChangeItem\" for ChangeItem entities."
    },
    "basedOn": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^[A-Z][A-Za-z0-9]*/[^/\\s]+$",
      "description": "Id of the object this object is derived from."
    },
    "entityDocumentationUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL for documentation about this entity."
    },
    "resourceType": {
      "type": "string",
      "description": "Resource category for this change item, such as rule, scope, protocol, record, or resource."
    },
    "operation": {
      "type": "string",
      "enum": ["update", "create", "delete", "replace"],
      "description": "Type of operation this item proposes for the target object."
    },
    "targetId": {
      "type": ["string", "null"],
      "x-ifs-id": true,
      "pattern": "^[A-Z][A-Za-z0-9]*/[^/\\s]+$",
      "description": "ID of the logical object being changed. Null for create operations."
    },
    "baseId": {
      "type": ["string", "null"],
      "x-ifs-id": true,
      "pattern": "^[A-Z][A-Za-z0-9]*/[^/\\s]+$",
      "description": "ID of the active version observed when authored, for conflict detection. Null for create operations."
    },
    "proposedId": {
      "type": ["string", "null"],
      "x-ifs-id": true,
      "pattern": "^[A-Z][A-Za-z0-9]*/[^/\\s]+$",
      "description": "ID of the proposed object or version. Null for delete operations."
    },
    "description": { "type": "string", "description": "Optional human-readable note explaining this specific item." },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this change item was created."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this change item was last updated."
    }
  },
  "required": [
    "id",
    "entityType",
    "entityDocumentationUrl",
    "resourceType",
    "operation",
    "targetId",
    "baseId",
    "proposedId",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "create" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "targetId": { "type": "null" },
          "baseId": { "type": "null" },
          "proposedId": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "delete" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "targetId": { "type": "string" },
          "baseId": { "type": "string" },
          "proposedId": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "enum": ["update", "replace"] } }, "required": ["operation"] },
      "then": {
        "properties": {
          "targetId": { "type": "string" },
          "baseId": { "type": "string" },
          "proposedId": { "type": "string" }
        }
      }
    }
  ],
  "x-ifs-relationships": []
}
