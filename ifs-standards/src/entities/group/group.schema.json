{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/group.schema.json",
  "title": "Group",
  "description": "A named grouping of members, organizations, or subgroups. Direct membership and subgroup inclusion are recorded as Relationship objects, not embedded collections. Each relationship connects the included entity to this group using a RelationshipType that allows those endpoint types, with startedAt and optional endedAt recording its duration. Membership and containment alone do not grant delegated authority or imply transitive membership.",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Group/[^/\\s]+$",
      "description": "Globally unique identifier for this group."
    },
    "entityType": {
      "type": "string",
      "const": "Group",
      "description": "Entity type discriminator. Always \"Group\" for Group entities."
    },
    "name": { "type": "string", "minLength": 1, "description": "Human-readable name of this group." },
    "description": { "type": "string", "description": "Purpose and context of this group." },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this group record was last updated."
    }
  },
  "required": ["name", "updatedAt"],
  "x-ifs-relationships": [
    { "relationshipTypeId": "RelationshipType/ifs.employed-by", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.manages", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.manages", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.member-of", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.member-of", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.oversees", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.oversees", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.owns", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "target" }
  ]
}
