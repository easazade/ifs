{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/organization.schema.json",
  "title": "Organization",
  "description": "An organization that may belong to a group. This basic schema defines only common entity properties.",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Organization/[^/\\s]+$",
      "description": "Globally unique identifier for this organization."
    },
    "entityType": {
      "type": "string",
      "const": "Organization",
      "description": "Entity type discriminator. Always \"Organization\" for Organization entities."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this organization record was last updated."
    }
  },
  "required": ["updatedAt"],
  "x-ifs-relationships": [
    { "relationshipTypeId": "RelationshipType/ifs.employed-by", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.manages", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.manages", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.member-of", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.member-of", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.oversees", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.oversees", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.owns", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.owns", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.partnered-with", "endpoint": "target" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "source" },
    { "relationshipTypeId": "RelationshipType/ifs.protects", "endpoint": "target" }
  ]
}
