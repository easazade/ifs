{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Rule/[^/\\s]+$",
      "description": "Globally unique identifier for this rule."
    },
    "entityType": {
      "type": "string",
      "const": "Rule",
      "description": "Entity type discriminator. Always \"Rule\" for Rule entities."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this rule record was last updated."
    }
  },
  "required": ["updatedAt"],
  "x-ifs-relationships": []
}
