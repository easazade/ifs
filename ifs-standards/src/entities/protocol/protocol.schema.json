{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/user.schema.json",
  "title": "Protocol",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "identifier protocol."
    },
    "ifsId": {
      "type": "string",
      "description": "IFS system identifier for this Protocol."
    },
    "entityType": {
      "type": "string",
      "const": "Protocol",
      "description": "Entity type discriminator. Always \"Protocol\" for Protocol entities."
    },
    "basedOn": {
      "type": "string",
      "description": "Id of the object this object is derived from."
    },
    "entityDocumentationUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL for documentation about this entity."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "createdAt",
    "ifsId",
    "entityType",
    "entityDocumentationUrl"
  ]
}
