{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/user.schema.json",
  "title": "Protocol",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "https://ifs-standards.org/schemas/v1/entities/entity.schema.json" }],
  "properties": {
    "id": {
      "type": "string",
      "x-ifs-id": true,
      "pattern": "^Protocol/[^/\\s]+$",
      "description": "identifier protocol."
    },
    "entityType": {
      "type": "string",
      "const": "Protocol",
      "description": "Entity type discriminator. Always \"Protocol\" for Protocol entities."
    }
  },
  "required": [],
  "x-ifs-relationships": []
}
