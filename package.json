{
  "name": "ifs-monorepo",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "openapi:generate": "pnpm --filter prototype-api openapi:generate",
    "client:generate": "pnpm openapi:generate && pnpm --filter @ifs/api-client generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "turbo": "^2.0.0"
  }
}
